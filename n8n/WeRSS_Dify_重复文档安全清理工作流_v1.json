    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out=[];\nfor(const item of $input.all()){\n  const value=item.json??{};\n  const rows=Array.isArray(value)?value:Array.isArray(value.body)?value.body:Array.isArray(value.data)?value.data:value.id?[value]:[];\n  for(const row of rows){\n    if(!row||typeof row!=='object')continue;\n    if(!row.id||!row.dataset_id||!row.duplicate_document_id||row.cleanup_ready!==true)continue;\n    out.push({json:row});\n  }\n}\nreturn out.length?out:[{json:{__empty:true}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-360, 120],
      "id": "7f1b6a21-1102-4e5a-9b77-000000000102",
