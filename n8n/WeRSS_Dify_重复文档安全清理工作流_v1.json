      "typeVersion": 4.4,
      "position": [120, 40],
      "id": "7f1b6a21-1104-4e5a-9b77-000000000104",
      "name": "[C08] 删除Dify重复文档",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpBearerAuth": {
          "id": "w2v3bI55opvN5I4h",
          "name": "DIFY Auth account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const tasks=$('[C06] 展开清理任务').all().filter(i=>i.json?.__empty!==true);\nreturn $input.all().map((item,index)=>{\n  let task=tasks[index]?.json??{};\n  try{const matched=$('[C06] 展开清理任务').itemMatching(index);if(matched?.json?.id)task=matched.json}catch{}\n  const response=item.json??{};\n  const statusCode=Number(response.statusCode??response.status_code??response.error?.statusCode??0);\n  const success=[200,202,204,404].includes(statusCode);\n  const error=success?null:String(response.body?.message??response.error?.message??response.message??`Dify删除失败 HTTP ${statusCode||'unknown'}`).slice(0,1500);\n  return {json:{...task,status_code:statusCode,delete_success:success,error},pairedItem:{item:index}};\n});"
      },
