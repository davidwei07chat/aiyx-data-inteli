        "url": "={{ (() => { const base=String($('[C03] 清理配置').first().json.difyApiBaseUrl).replace(/\\/+$/,''); const api=base.endsWith('/v1')?base:base+'/v1'; return api + '/datasets/' + encodeURIComponent($json.dataset_id) + '/documents/' + encodeURIComponent($json.duplicate_document_id); })() }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "options": {
          "response": {
            "response": {
              "includeResponseHeadersAndStatus": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 120000,
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 1000
            }
          }
        }
      },
