    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "let summary={cleanup_checked:0,cleanup_deleted:0,cleanup_failed:0};\ntry{summary=$('[C11] 汇总清理结果').first().json}catch{try{summary=$('[C12] 无清理任务').first().json}catch{}}\nlet snapshot={};\nfor(const item of $input.all()){const j=item.json??{};if(Array.isArray(j)&&j[0]){snapshot=j[0];break}if(Array.isArray(j.body)&&j.body[0]){snapshot=j.body[0];break}if(j.article_total!==undefined){snapshot=j;break}}\nconst now=new Intl.DateTimeFormat('zh-CN',{timeZone:'Asia/Shanghai',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).format(new Date()).replace(/\\//g,'-');\nconst hasIssue=Number(summary.cleanup_failed||0)>0||Number(snapshot.dify_cleanup_review_count||0)>0;\nconst title=hasIssue?'⚠️ Dify重复文档清理完成（有异常）':'✅ Dify重复文档清理完成';\nconst text=`${title}\n\n工作流：${$workflow.name}\n执行 ID：${$execution.id}\n完成时间：${now}\n\n本轮检查：${Number(summary.cleanup_checked||0)} 个\n成功删除或原本不存在：${Number(summary.cleanup_deleted||0)} 个\n删除失败：${Number(summary.cleanup_failed||0)} 个\n\n待清理：${Number(snapshot.dify_cleanup_pending_count||0)} 个\n当前可安全清理：${Number(snapshot.dify_cleanup_ready_count||0)} 个\n累计已完成：${Number(snapshot.dify_cleanup_completed_count||0)} 个\n人工复核：${Number(snapshot.dify_cleanup_review_count||0)} 个\n\nDify待创建/更新：${Number(snapshot.dify_queue_count||0)} 个\nDify处理中：${Number(snapshot.dify_processing_count||0)} 个`;\nreturn [{json:{...summary,...snapshot,success:!hasIssue,feishu_text:text}}];"
      },
      "type": "n8n-nodes-base.code",
