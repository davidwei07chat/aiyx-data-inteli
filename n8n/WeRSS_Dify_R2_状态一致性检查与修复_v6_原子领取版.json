    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const jobs=$('[R02] 展开R2任务').all().filter(i=>i.json?.__empty!==true);function hv(h,n){if(!h||typeof h!=='object')return null;const k=Object.keys(h).find(x=>x.toLowerCase()===n);const v=k?h[k]:null;return Array.isArray(v)?v[0]:v}return $input.all().map((item,index)=>{let job=jobs[index]?.json??{};try{const m=$('[R02] 展开R2任务').itemMatching(index);if(m?.json?.image_md5)job=m.json}catch{}const e=item.json??{};const code=Number(e.statusCode??e.status_code??e.error?.statusCode??0);const headers=e.headers??e.response?.headers??{};const verify=code>=200&&code<400?'verified':code===404?'missing':'error';const len=Number(hv(headers,'content-length'));return{json:{...job,verify_status:verify,error:verify==='verified'?null:verify==='missing'?'R2 object returned HTTP 404':String(e.error?.message??e.message??`HTTP ${code||'unknown'}`).slice(0,1500),content_length:Number.isFinite(len)?len:null,content_type:hv(headers,'content-type')},pairedItem:{item:index}}});"
