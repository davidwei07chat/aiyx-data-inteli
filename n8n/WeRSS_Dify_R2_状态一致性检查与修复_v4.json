      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const responses = $input.all();\nconst sourceItems = $('[D01] 读取Dify处理中任务').all();\n\nfunction getJob(index) {\n  try {\n    const matched = $('[D01] 读取Dify处理中任务').itemMatching(index);\n    if (matched?.json?.record_key) return matched.json;\n  } catch {}\n  return sourceItems[index]?.json ?? {};\n}\n\nreturn responses.map((item, index) => {\n  const job = getJob(index);\n  const envelope = item.json ?? {};\n  const statusCode = Number(envelope.statusCode ?? envelope.status_code ?? 200);\n  const response = envelope.body ?? envelope.data ?? envelope;\n  const documents = Array.isArray(response?.data)\n    ? response.data\n    : Array.isArray(response?.documents)\n      ? response.documents\n      : Array.isArray(response?.data?.documents)\n        ? response.data.documents\n        : [];\n  const states = documents\n    .map((document) => String(document?.indexing_status ?? document?.status ?? '').toLowerCase())\n    .filter(Boolean);\n\n  let indexingStatus = 'processing';\n  let errorMessage = null;\n\n  if (statusCode >= 400) {\n    indexingStatus = 'error';\n    errorMessage = JSON.stringify(response).slice(0, 1500);\n  } else if (states.some((state) => ['error','failed','paused','stopped'].includes(state))) {\n    indexingStatus = 'error';\n    errorMessage = JSON.stringify(response).slice(0, 1500);\n  } else if (states.length > 0 && states.every((state) => ['completed','success','indexed','available'].includes(state))) {\n    indexingStatus = 'completed';\n  }\n\n  return {\n    json: {\n      ...job,\n      indexing_status: indexingStatus,\n      error_message: errorMessage,\n      raw_status_code: statusCode,\n      raw_states: states,\n    },\n    pairedItem: { item: index },\n  };\n});"
      },
