      "position": [-360, 300],
      "id": "9c1c3c59-7e95-4c78-8e1b-94ea8eaa1203",
      "name": "[R03] HEAD验证R2对象",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const responses = $input.all();\nconst sourceItems = $('[R01] 读取R2待验证图片').all();\n\nfunction getJob(index) {\n  try {\n    const matched = $('[R01] 读取R2待验证图片').itemMatching(index);\n    if (matched?.json?.image_md5) return matched.json;\n  } catch {}\n  return sourceItems[index]?.json ?? {};\n}\n\nfunction headerValue(headers, name) {\n  if (!headers || typeof headers !== 'object') return null;\n  const key = Object.keys(headers).find((entry) => entry.toLowerCase() === name.toLowerCase());\n  const value = key ? headers[key] : null;\n  return Array.isArray(value) ? value[0] : value;\n}\n\nreturn responses.map((item, index) => {\n  const job = getJob(index);\n  const response = item.json ?? {};\n  const statusCode = Number(response.statusCode ?? response.status_code ?? response.error?.statusCode ?? 0);\n  const headers = response.headers ?? response.response?.headers ?? {};\n  let verifyStatus = 'error';\n  if (statusCode >= 200 && statusCode < 400) verifyStatus = 'verified';\n  else if (statusCode === 404) verifyStatus = 'missing';\n\n  const rawLength = headerValue(headers, 'content-length');\n  const contentLength = Number.isFinite(Number(rawLength)) ? Number(rawLength) : null;\n  const contentType = headerValue(headers, 'content-type');\n  const error = verifyStatus === 'error'\n    ? String(response.error?.message ?? response.message ?? `HTTP ${statusCode || 'unknown'}`).slice(0, 1500)\n    : verifyStatus === 'missing'\n      ? 'R2 object returned HTTP 404'\n      : null;\n\n  return {\n    json:{\n      ...job,\n      verify_status:verifyStatus,\n      status_code:statusCode,\n      content_length:contentLength,\n      content_type:contentType,\n      error,\n    },\n    pairedItem:{item:index},\n  };\n});"
      },
