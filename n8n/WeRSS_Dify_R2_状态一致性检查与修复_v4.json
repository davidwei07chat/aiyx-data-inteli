    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map((item)=>item.json ?? {});\nconst merged = Object.assign({}, ...rows);\nconst dify = rows.find((row)=>row.branch==='dify') ?? {};\nconst r2 = rows.find((row)=>row.branch==='r2') ?? {};\nconst now = new Intl.DateTimeFormat('zh-CN',{timeZone:'Asia/Shanghai',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).format(new Date()).replace(/\\//g,'-');\nconst hasIssue = Number(dify.failed||0)>0 || Number(r2.missing||0)>0 || Number(r2.failed||0)>0;\nconst title = hasIssue ? '⚠️ WeRSS Dify R2 状态检查完成（有异常）' : '✅ WeRSS Dify R2 状态检查完成';\nconst text = `${title}\n\n工作流：${$workflow.name}\n执行 ID：${$execution.id}\n完成时间：${now}\n\nDify 索引检查：${Number(dify.checked||0)} 个\n已完成并回写 synced：${Number(dify.completed||0)} 个\n仍在 processing：${Number(dify.processing||0)} 个\n索引失败：${Number(dify.failed||0)} 个\n\nR2 对象检查：${Number(r2.checked||0)} 张\n验证成功：${Number(r2.verified||0)} 张\n对象缺失：${Number(r2.missing||0)} 张\n验证失败：${Number(r2.failed||0)} 张`;\nreturn [{json:{...merged,success:!hasIssue,feishu_text:text}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 140],
