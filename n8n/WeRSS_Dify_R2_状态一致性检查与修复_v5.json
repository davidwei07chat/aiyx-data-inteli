        "jsCode": "const summary=$('[M02] 合并状态统计').first().json ?? {};\nconst input=$input.all().map((item)=>item.json ?? {});\nlet snapshot={};\nfor(const value of input){\n  if(Array.isArray(value)&&value[0]){snapshot=value[0];break;}\n  if(Array.isArray(value.body)&&value.body[0]){snapshot=value.body[0];break;}\n  if(value.article_total!==undefined){snapshot=value;break;}\n}\nconst now=new Intl.DateTimeFormat('zh-CN',{timeZone:'Asia/Shanghai',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).format(new Date()).replace(/\\//g,'-');\nconst hasIssue=Number(summary.dify_failed||0)>0||Number(summary.dify_write_failed||0)>0||Number(summary.r2_missing||0)>0||Number(summary.r2_failed||0)>0||Number(summary.r2_write_failed||0)>0||Number(snapshot.r2_missing_count||0)>0||Number(snapshot.r2_error_count||0)>0;\nconst title=hasIssue?'⚠️ WeRSS Dify R2 状态检查完成（有异常）':'✅ WeRSS Dify R2 状态检查完成';\nconst text=`${title}\n\n工作流：${$workflow.name}\n执行 ID：${$execution.id}\n完成时间：${now}\n\n本轮 Dify 检查：${Number(summary.dify_checked||0)} 个\n本轮完成并回写 synced：${Number(summary.dify_completed||0)} 个\n本轮仍在 processing：${Number(summary.dify_processing||0)} 个\n本轮索引失败：${Number(summary.dify_failed||0)} 个\nDify 状态回写失败：${Number(summary.dify_write_failed||0)} 个\n\n本轮 R2 检查：${Number(summary.r2_checked||0)} 张\n本轮验证成功：${Number(summary.r2_verified||0)} 张\n本轮对象缺失：${Number(summary.r2_missing||0)} 张\n本轮验证失败：${Number(summary.r2_failed||0)} 张\nR2 状态回写失败：${Number(summary.r2_write_failed||0)} 张\n\n最终状态快照：\n待创建/更新 Dify：${Number(snapshot.dify_queue_count||0)}\nDify processing：${Number(snapshot.dify_processing_count||0)}\nDify stale：${Number(snapshot.dify_processing_stale_count||0)}\nsource 已同步：${Number(snapshot.source_synced_count||0)}\nprofile 已同步：${Number(snapshot.profile_synced_count||0)}\n图片资产：${Number(snapshot.image_asset_count||0)}\n已命名图片资产：${Number(snapshot.image_asset_named_count||0)}\nR2 已验证：${Number(snapshot.r2_verified_count||0)}\nR2 缺失：${Number(snapshot.r2_missing_count||0)}\nR2 验证错误：${Number(snapshot.r2_error_count||0)}\n实体图片关系：${Number(snapshot.entity_image_relation_count||0)}\n精确章节关联：${Number(snapshot.entity_image_exact_count||0)}\n文章降级关联：${Number(snapshot.entity_image_fallback_count||0)}`;\nreturn [{json:{...summary,...snapshot,success:!hasIssue,feishu_text:text}}];"
      },
