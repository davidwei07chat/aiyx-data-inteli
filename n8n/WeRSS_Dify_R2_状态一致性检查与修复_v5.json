    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const responses = $input.all();\nconst jobs = $('[D02] 展开Dify任务数组').all().filter((item)=>item.json?.__empty !== true);\nreturn responses.map((item,index)=>{\n  let job = jobs[index]?.json ?? {};\n  try {\n    const matched = $('[D02] 展开Dify任务数组').itemMatching(index);\n    if (matched?.json?.record_key) job = matched.json;\n  } catch {}\n  const envelope = item.json ?? {};\n  const statusCode = Number(envelope.statusCode ?? envelope.status_code ?? envelope.error?.statusCode ?? 200);\n  const response = envelope.body ?? envelope.data ?? envelope;\n  const documents = Array.isArray(response?.data)\n    ? response.data\n    : Array.isArray(response?.documents)\n      ? response.documents\n      : Array.isArray(response?.data?.documents)\n        ? response.data.documents\n        : [];\n  const states = documents.map((document)=>String(document?.indexing_status ?? document?.status ?? '').toLowerCase()).filter(Boolean);\n  const documentErrors = documents.map((document)=>document?.error).filter(Boolean);\n  let indexingStatus = 'processing';\n  let errorMessage = null;\n  if (statusCode >= 400) {\n    indexingStatus = 'error';\n    errorMessage = JSON.stringify(response).slice(0,1500);\n  } else if (states.some((state)=>['error','failed','stopped'].includes(state))) {\n    indexingStatus = 'error';\n    errorMessage = String(documentErrors[0] ?? JSON.stringify(response)).slice(0,1500);\n  } else if (states.length > 0 && states.every((state)=>state === 'completed')) {\n    indexingStatus = 'completed';\n  }\n  return {\n    json:{...job,indexing_status:indexingStatus,error_message:errorMessage,raw_status_code:statusCode,raw_states:states},\n    pairedItem:{item:index}\n  };\n});"
      },
