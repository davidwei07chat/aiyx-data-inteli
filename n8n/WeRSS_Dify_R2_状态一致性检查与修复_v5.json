    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const responses=$input.all();\nconst jobs=$('[R02] 展开R2任务数组').all().filter((item)=>item.json?.__empty!==true);\nfunction headerValue(headers,name){\n  if(!headers||typeof headers!=='object')return null;\n  const key=Object.keys(headers).find((entry)=>entry.toLowerCase()===name.toLowerCase());\n  const value=key?headers[key]:null;\n  return Array.isArray(value)?value[0]:value;\n}\nreturn responses.map((item,index)=>{\n  let job=jobs[index]?.json ?? {};\n  try {\n    const matched=$('[R02] 展开R2任务数组').itemMatching(index);\n    if(matched?.json?.image_md5)job=matched.json;\n  } catch {}\n  const response=item.json ?? {};\n  const statusCode=Number(response.statusCode ?? response.status_code ?? response.error?.statusCode ?? 0);\n  const headers=response.headers ?? response.response?.headers ?? {};\n  let verifyStatus='error';\n  if(statusCode>=200&&statusCode<400)verifyStatus='verified';\n  else if(statusCode===404)verifyStatus='missing';\n  const rawLength=headerValue(headers,'content-length');\n  const contentLength=Number.isFinite(Number(rawLength))?Number(rawLength):null;\n  const contentType=headerValue(headers,'content-type');\n  const error=verifyStatus==='error'?String(response.error?.message ?? response.message ?? `HTTP ${statusCode||'unknown'}`).slice(0,1500):verifyStatus==='missing'?'R2 object returned HTTP 404':null;\n  return {json:{...job,verify_status:verifyStatus,status_code:statusCode,content_length:contentLength,content_type:contentType,error},pairedItem:{item:index}};\n});"
